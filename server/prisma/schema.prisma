datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Project {
  id            String      @id @default(uuid())
  name          String
  client        String
  clientEmail   String?
  clientPhone   String?
  dueLabel      String
  overallStatus String      @default("Em Homologação")
  accessCode    String      @unique @default("NF-2024-001")
  createdAt     DateTime    @default(now())
  milestones    Milestone[]
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("MANAGER")
  createdAt DateTime @default(now())
}

model Milestone {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  status    String   @default("pending")
  dateLabel String
  summary   String
  demoUrl   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model AuditEntry {
  id        String   @id @default(uuid())
  text      String
  timestamp String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}
